original-agents/
original-file/
research/

# Whatever install.sh displaced from the Claude config dir or a project's .claude/rules/
.install-backup/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/settings.json
*.swp

# Per-machine assistant settings
.claude/settings.local.json

# Node (if tooling is ever added alongside)
node_modules/

# Local agent and per-machine Claude data. A shared .claude/settings.json may be
# committed; settings.local.json is not. Anything installed into .claude/skills/ by hand
# stays ignored; only the named maintainer-only skills for THIS repo are committed (not
# under the shipped skills/ tree, so the installer never offers them). Add a line per
# maintainer skill. `.agents/` is a legacy third-party install location (kept ignored).
.agents/
.claude/*
!.claude/settings.json
!.claude/skills/
.claude/skills/*
!.claude/skills/regrounding-references/
